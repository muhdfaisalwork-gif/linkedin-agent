# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,inclusionai/ling-3.0-flash-sante:free,nvidia/nemotron-3.5-lightning:free

# Dashboard Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# LinkedIn Execution Mode: browser, publora, or manual
LINKEDIN_EXECUTION_MODE=manual

# Optional Publora API
PUBLORA_API_KEY=
LINKEDIN_PLATFORM_ID=

# Optional Apify Scraper Token
APIFY_TOKEN=

# Optional Pixfaro Image Token
PIXFARO_TOKEN=
